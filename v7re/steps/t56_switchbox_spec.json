 "criteria": {
  "PASS": "内容位集合（word!=50）归一化到 (off=f-base, word, bit) 后与 expected[键] 逐位相等，且 missing=0 extra=0、窗口 off 16..25 之外零变化",
  "主判据": "XOR 判据为主：B-A 与 C-A 都不依赖 BEG 走线，只依赖 sink mux 的选择位",
  "PURE": "abs(B) 在窗口内必须为空（VCC_WIRE=零态的直接证明）",
  "FAIL": "missing>0 或 extra>0 或出现窗口 off 16..25 之外的帧",
  "reject_if": "base2Δbase != 0（构建不确定）；此时仍可用同一 DCP 的 A/B/C 做 XOR 判据，但 PURE/绝对集结论作废"
 },
 "fallbacks": {
  "R1_swap_pip_missing": "swap_source.py 报 PIP not found => 该 tile 的 IMUX 源集合与模板不符（结构性差异）；先用 templates/INT_L.json 的 pip_defs 按 dst 分组复核，确缺则改用按名删除 PIN 语义（pip_edit 显式删 '->>IMUX_L8'，禁止按索引删）",
  "R2_actual_family_differs": "preflight 显示 net n1 未从 IMUX_L8 进入（或 site pip 不是 IMUX8->A5）=> 用该 family 的 law 重算预测（改 FAMILY 常量）；先查 LOCK_PINS/BEL 是否被工具改写",
  "R3_base_or_word_mismatch": "diff 帧落在窗口但对 base 系统性偏移 => 先用 pip_bits 的 24 条实测行回归地址律，再决定是否换 band/tile 对",
  "R4_route_not_reproducible": "base2Δbase != 0 => 放弃绝对集，仅用同一 DCP 内的 A/B/C 做 XOR 判据（判据仍有效）",
  "R5_hot_group_coverage_incomplete": "A→C 只覆盖 10 个格中的 6 个（独热格 16/17/18/20 未覆盖）=> 另选 4 个源（各占一个独热组）各做一次 swap，判据同构；25 个源在 T2 的预测见本文件 table_all_sources_T2，无需重算",
  "R6_source_set_conflict": "同 tile_type 的 IMUX 源集合由 routing 模板统一给出，理论无冲突；若真冲突，退回 PIP_ADDRESS_ENCODING_LAW.md §5 的 36 组行映射按族固化作为输入"
 }
